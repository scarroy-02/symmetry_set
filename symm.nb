Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"header", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exportData", "=", 
