    RowBox[{"b", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmin", "=", "3.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmax", "=", 
     RowBox[{"tmin", "+", 
      RowBox[{"3.5", "*", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ROuter", "=", "4.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thickness", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RInner", "=", 
     RowBox[{"ROuter", "-", "thickness"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aOuter", "=", 
     RowBox[{"ROuter", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"b", "*", "tmin"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aInner", "=", 
     RowBox[{"RInner", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"b", "*", "tmin"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"innerSpiral", "[", "t_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"aInner", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Cos", "[", "t", "]"}]}], ",", 
      RowBox[{"aInner", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}]}], "\n", 
   RowBox[{
    RowBox[{"outerSpiral", "[", "t_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"aOuter", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Cos", "[", "t", "]"}]}], ",", 
      RowBox[{"aOuter", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}]}]}]}]], "Input",
