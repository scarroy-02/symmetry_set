Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "two", " ", "equations"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"norm", "[", "t_", "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "^", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"unitTangent", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}]}], "}"}], "/", 
      RowBox[{"norm", "[", "t", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"unitNormal", "[", "t_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"T", "=", 
         RowBox[{"unitTangent", "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"T", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"T", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "compute", " ", "curvature", " ", "at", " ", 
     "parameter", " ", "t"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeCurvature", "[", 
      RowBox[{"t_", ",", 
       RowBox[{"dt_", ":", " ", "1*^-5"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "dx", ",", "dy", ",", "ddx", ",", "ddy", ",", "numerator", ",", 
         "denominator"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"First", " ", "derivatives"}], "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"dx", "=", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dy", "=", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Second", " ", "derivatives"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"ddx", "=", 
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"ddy", "=", 
         RowBox[{
          RowBox[{"y", "''"}], "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Curvature", " ", 
           RowBox[{"formula", ":", "\[Kappa]"}]}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], 
              RowBox[{"y", "''"}]}], "-", 
             RowBox[{
              RowBox[{"y", "'"}], 
              RowBox[{"x", "''"}]}]}], ")"}], "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"x", "'"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"y", "'"}], "^", "2"}]}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"numerator", "=", 
         RowBox[{
          RowBox[{"dx", "*", "ddy"}], "-", 
          RowBox[{"dy", "*", "ddx"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"denominator", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dx", "^", "2"}], "+", 
            RowBox[{"dy", "^", "2"}]}], ")"}], "^", "1.5"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "denominator", "]"}], "<", "1*^-10"}], ",", 
          "0.0", ",", 
          RowBox[{"numerator", "/", "denominator"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "compute", " ", "focal", " ", "point", " ", 
     "at", " ", "parameter", " ", "t"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFocalPoint", "[", 
      RowBox[{"t_", ",", 
       RowBox[{"RMax_", ":", " ", "10.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "N", ",", "kappa", ",", "R", ",", "focalPoint"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], ",", 
           RowBox[{"y", "[", "t", "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"N", "=", 
         RowBox[{"unitNormal", "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"kappa", "=", 
         RowBox[{"computeCurvature", "[", "t", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "If", " ", "curvature", " ", "is", " ", "too", " ", "small"}], ",", 
          "skip"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "kappa", "]"}], "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Radius", " ", "of", " ", "curvature"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"R", "=", 
         RowBox[{"1.0", "/", "kappa"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", " ", "radius", " ", "is", " ", "too", " ", "large"}], 
          ",", "skip"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "R", "]"}], ">", "RMax"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Focal", " ", "point", " ", "is", " ", "at", " ", "distance", " ", 
          "R", " ", "along", " ", "the", " ", "normal"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"focalPoint", "=", 
         RowBox[{"p", "+", 
          RowBox[{"N", "*", "R"}]}]}], ";", "\[IndentingNewLine]", 
        "focalPoint"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "compute", " ", "all", " ", "focal", " ", 
     "set", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFocalSet", "[", 
      RowBox[{
       RowBox[{"resolution_", ":", " ", "2000"}], ",", 
       RowBox[{"RMax_", ":", " ", "10.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dt", ",", "tValues", ",", 
         RowBox[{"focalPoints", "=", 
          RowBox[{"{", "}"}]}], ",", "fp"}], "}"}], ",", 
       RowBox[{
        RowBox[{"dt", "=", 
         RowBox[{"2", 
          RowBox[{"Pi", "/", "resolution"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tValues", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "Pi"}], "+", 
            RowBox[{"i", "*", "dt"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "resolution"}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fp", "=", 
            RowBox[{"computeFocalPoint", "[", 
             RowBox[{"t", ",", "RMax"}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"fp", "=!=", "Null"}], "&&", 
              RowBox[{"!", 
               RowBox[{"AnyTrue", "[", 
                RowBox[{"fp", ",", 
                 RowBox[{"Not", "@*", "NumericQ"}]}], "]"}]}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"focalPoints", ",", "fp"}], "]"}]}], "]"}], ";"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"t", ",", "tValues"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "focalPoints"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "focal", " ", "set"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Computing focal set...\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"focalPoints", "=", 
     RowBox[{"computeFocalSet", "[", 
      RowBox[{"2000", ",", "10.0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "focalPoints", "]"}], ",", 
      "\"\< focal set points.\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"eq1", "[", 
      RowBox[{"t1_", ",", "t2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "t1", "]"}], ",", 
          RowBox[{"y", "[", "t1", "]"}]}], "}"}], "-", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "t2", "]"}], ",", 
          RowBox[{"y", "[", "t2", "]"}]}], "}"}]}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"unitTangent", "[", "t1", "]"}], "+", 
        RowBox[{"unitTangent", "[", "t2", "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"eq2", "[", 
      RowBox[{"t1_", ",", "t2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "t1", "]"}], ",", 
          RowBox[{"y", "[", "t1", "]"}]}], "}"}], "-", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "t2", "]"}], ",", 
          RowBox[{"y", "[", "t2", "]"}]}], "}"}]}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"unitTangent", "[", "t1", "]"}], "-", 
        RowBox[{"unitTangent", "[", "t2", "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "find", " ", "sign", " ", "change", " ", 
     "points", " ", "for", " ", "a", " ", "fixed", " ", "t1"}], "*)"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"findSignChanges", "[", 
      RowBox[{
       RowBox[{"t1_", "?", "NumericQ"}], ",", 
       RowBox[{"dt_", ":", " ", "0.01"}], ",", 
       RowBox[{"lambdaMax_", ":", " ", "3.0"}], ",", 
       RowBox[{"tangentThreshold_", ":", " ", "1*^-5"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t2Values", ",", "thresholdIdx", ",", 
         RowBox[{"signChanges", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"prevCheck1", "=", "Null"}], ",", 
         RowBox[{"prevCheck2", "=", "Null"}], ",", 
         RowBox[{"prevT2", "=", "Null"}], ",", "T1", ",", "N1", ",", "T2", 
         ",", "N2", ",", "p1", ",", "p2", ",", "diff", ",", "TsumVec", ",", 
         "TdiffVec", ",", "eqCheck1", ",", "eqCheck2", ",", "alpha", ",", 
         "tInterp", ",", "pInterp", ",", "NInterp", ",", "Nvec", ",", "denom",
          ",", "lam", ",", "center"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Generate", " ", "t2", " ", "values", " ", "from"}], "-", 
         RowBox[{"Pi", " ", "to", " ", "Pi"}]}], "*)"}], 
       RowBox[{
        RowBox[{"t2Values", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "Pi"}], ",", "Pi", ",", "dt"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"thresholdIdx", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"Floor", "[", 
            RowBox[{"0.05", "*", 
             RowBox[{"Length", "[", "t2Values", "]"}]}], "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Get", " ", "tangent", " ", "and", " ", "normal", " ", "for", " ", 
          "t1"}], "*)"}], 
        RowBox[{"T1", "=", 
         RowBox[{"unitTangent", "[", "t1", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"N1", "=", 
         RowBox[{"unitNormal", "[", "t1", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"p1", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", "t1", "]"}], ",", 
           RowBox[{"y", "[", "t1", "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Loop", " ", "through", " ", "t2", " ", "values"}], ",", 
          RowBox[{"starting", " ", "from", " ", "threshold", " ", "index"}]}],
          "*)"}], 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"T2", "=", 
            RowBox[{"unitTangent", "[", 
             RowBox[{"t2Values", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"N2", "=", 
            RowBox[{"unitNormal", "[", 
             RowBox[{"t2Values", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"p2", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"t2Values", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", 
              RowBox[{"y", "[", 
               RowBox[{"t2Values", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "Skip", " ", "if", " ", "tangents", " ", "are", " ", "parallel", 
              " ", "or", " ", "anti"}], "-", "parallel"}], "*)"}], 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Norm", "[", 
                RowBox[{"T1", "-", "T2"}], "]"}], "<", "tangentThreshold"}], "||", 
              RowBox[{
               RowBox[{"Norm", "[", 
                RowBox[{"T1", "+", "T2"}], "]"}], "<", "tangentThreshold"}]}],
              ",", 
             RowBox[{
              RowBox[{"prevCheck1", "=", "Null"}], ";", "\[IndentingNewLine]", 
              RowBox[{"prevCheck2", "=", "Null"}], ";", "\[IndentingNewLine]", 
              RowBox[{"prevT2", "=", 
               RowBox[{"t2Values", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Compute", " ", "tangency", " ", "conditions"}], "*)"}], 
           RowBox[{"diff", "=", 
            RowBox[{"p1", "-", "p2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"TsumVec", "=", 
            RowBox[{"T1", "+", "T2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"TdiffVec", "=", 
            RowBox[{"T1", "-", "T2"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"eqCheck1", "=", 
            RowBox[{"diff", ".", "TsumVec"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"eqCheck2", "=", 
            RowBox[{"diff", ".", "TdiffVec"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Check", " ", "for", " ", "sign", " ", "changes"}], 
            "*)"}], 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"prevCheck1", "=!=", "Null"}], ",", 
             RowBox[{"(*", 
              RowBox[{"Check", " ", "eq1", " ", "sign", " ", "change"}], 
              "*)"}], 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"prevCheck1", "*", "eqCheck1"}], "<", "0"}], ",", 
                RowBox[{
                 RowBox[{"alpha", "=", 
                  RowBox[{
                   RowBox[{"Abs", "[", "prevCheck1", "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck1", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck1", "]"}]}], ")"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"tInterp", "=", 
                  RowBox[{"prevT2", "+", 
                   RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"t2Values", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", "prevT2"}], 
                    ")"}]}]}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"pInterp", "=", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"x", "[", "tInterp", "]"}], ",", 
                    RowBox[{"y", "[", "tInterp", "]"}]}], "}"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"NInterp", "=", 
                  RowBox[{"unitNormal", "[", "tInterp", "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Nvec", "=", 
                  RowBox[{"N1", "+", "NInterp"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"denom", "=", 
                  RowBox[{"Nvec", ".", "Nvec"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                   RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{
                    RowBox[{"center", "=", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"signChanges", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "t1", ",", "tInterp", ",", "\"\<eq1\>\"", ",", "p1", ",", 
                    "pInterp", ",", "lam", ",", "center"}], "}"}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Check", " ", "eq2", " ", "sign", " ", "change"}], 
               "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"prevCheck2", "*", "eqCheck2"}], "<", "0"}], ",", 
                RowBox[{
                 RowBox[{"alpha", "=", 
                  RowBox[{
                   RowBox[{"Abs", "[", "prevCheck2", "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck2", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck2", "]"}]}], ")"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"tInterp", "=", 
                  RowBox[{"prevT2", "+", 
                   RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"t2Values", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", "prevT2"}], 
                    ")"}]}]}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"pInterp", "=", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"x", "[", "tInterp", "]"}], ",", 
                    RowBox[{"y", "[", "tInterp", "]"}]}], "}"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"NInterp", "=", 
                  RowBox[{"unitNormal", "[", "tInterp", "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Nvec", "=", 
                  RowBox[{"N1", "-", "NInterp"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"denom", "=", 
                  RowBox[{"Nvec", ".", "Nvec"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                   RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{
                    RowBox[{"center", "=", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"signChanges", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "t1", ",", "tInterp", ",", "\"\<eq2\>\"", ",", "p1", ",", 
                    "pInterp", ",", "lam", ",", "center"}], "}"}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Update", " ", "previous", " ", "values"}], "*)"}], 
           RowBox[{"prevCheck1", "=", "eqCheck1"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"prevCheck2", "=", "eqCheck2"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"prevT2", "=", 
            RowBox[{"t2Values", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"thresholdIdx", "+", "1"}], ",", 
            RowBox[{"Length", "[", "t2Values", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "signChanges"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Scan", " ", "over", " ", "all", " ", "t1", " ", "values"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"scanAllT1", "[", 
      RowBox[{
       RowBox[{"dt_", ":", " ", "0.01"}], ",", 
       RowBox[{"lambdaMax_", ":", " ", "3.0"}], ",", 
       RowBox[{"tangentThreshold_", ":", " ", "1*^-5"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t1Values", ",", 
         RowBox[{"allResults", "=", 
          RowBox[{"{", "}"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"t1Values", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "Pi"}], ",", "Pi", ",", "dt"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"allResults", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"allResults", ",", 
              RowBox[{"findSignChanges", "[", 
               RowBox[{
               "t1val", ",", "dt", ",", "lambdaMax", ",", 
                "tangentThreshold"}], "]"}]}], "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"t1val", ",", "t1Values"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "allResults"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Run", " ", "the", " ", "scan"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"scanAllT1", "[", 
      RowBox[{"0.01", ",", "4.0", ",", "1*^-5"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "centers"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"centers", "=", 
     RowBox[{"results", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "7"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "centers", "]"}], ",", 
      "\"\< symmetry set points.\>\""}], "]"}], ";"}]}]}]], "Input",
