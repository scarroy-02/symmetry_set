 CellChangeTimes->{3.971955094819607*^9},
 CellLabel->
  "Out[160]=",ExpressionUUID->"eed6c045-be0d-4b04-a9ca-af512a86b252"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"header", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exportData", "=", 
