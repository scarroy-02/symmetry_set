Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "all", " ", "together"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Import", " ", "the", " ", "data"}], "*)"}], 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Import", "[", "\"\<potato_plot.csv\>\"", "]"}]}], ";", "\n", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Parse", " ", "the", " ", "data"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"curvePoints", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<curve\>\""}], 
         "&"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;", "3"}]}], "]"}], "]"}]}], ";", "\n", 
    RowBox[{"symmetryPoints", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
