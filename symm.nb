Cell[CellGroupData[{

Cell["Symmetry set from implicit curves", "Subtitle",
 CellChangeTimes->{{3.971521954685066*^9, 
  3.971521971814397*^9}},ExpressionUUID->"6ef6c3c7-7b1d-4d3a-9fdb-\
4286ef3143bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "constants", " ", "for", " ", "the", " ", "implicit", " ", 
    "curve"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", "1.025"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b", "=", "0.09"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a2", "=", 
     RowBox[{"a", "^", "2"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Implicit", " ", "curve", " ", "equation", " ", "F", 
      RowBox[{"(", 
       RowBox[{"x", ",", "y"}], ")"}]}], "=", 
     RowBox[{"0", "-", 
      RowBox[{"as", " ", "numerical", " ", "functions"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"y", "^", "2"}], "-", 
      RowBox[{"2", "*", "b", "*", "x", "*", "y"}], "-", 
      RowBox[{"a2", "*", "x"}], "+", 
      RowBox[{"a2", "*", 
       RowBox[{"x", "^", "3"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Partial", " ", "derivatives"}], "-", 
     RowBox[{"computed", " ", "numerically"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Fx", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", "b", "*", "y"}], "-", "a2", "+", 
      RowBox[{"3", "*", "a2", "*", 
       RowBox[{"x", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fy", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "*", "y"}], "-", 
      RowBox[{"2", "*", "b", "*", "x"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fxx", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"6", "*", "a2", "*", "x"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fyy", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", "2.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fxy", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "2.0"}], "*", "b"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "for", " ", "y", " ", "given", " ", "x"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"solveYForX", "[", 
      RowBox[{"xval_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"discriminant", ",", "sqrtD", ",", "y1", ",", "y2"}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"discriminant", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "b", "*", "xval"}], ")"}], "^", "2"}], "-", 
          RowBox[{"4", "*", "1", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "a2"}], "*", "xval"}], "+", 
             RowBox[{"a2", "*", 
              RowBox[{"xval", "^", "3"}]}]}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"discriminant", "<", "1*^-9"}], ",", 
          RowBox[{"discriminant", "=", "0"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sqrtD", "=", 
         RowBox[{"Sqrt", "[", "discriminant", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"y1", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "b", "*", "xval"}], "+", "sqrtD"}], ")"}], "/", 
          "2.0"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"y2", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "b", "*", "xval"}], "-", "sqrtD"}], ")"}], "/", 
          "2.0"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"y1", ",", "y2"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Trace", " ", "the", " ", "curve", " ", "loop"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"traceCurveLoop", "[", 
      RowBox[{"resolution_", ":", " ", "800"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "roots", ",", "xMax", ",", "xValsForward", ",", "upperBranch", ",", 
         "lowerBranch", ",", "y1", ",", "y2"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
          "Find", " ", "the", " ", "positive", " ", "root", " ", "of"}], "-", 
          
          RowBox[{
           RowBox[{"a", "^", "2"}], "*", 
           RowBox[{"x", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"b", "^", "2"}], "*", "x"}], "+", 
          RowBox[{"a", "^", "2"}]}], "=", "0"}], "*)"}], 
       RowBox[{
        RowBox[{"roots", "=", 
         RowBox[{"x", "/.", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "a2"}], "*", 
               RowBox[{"x", "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{"b", "^", "2"}], "*", "x"}], "+", "a2"}], "\[Equal]", 
             "0"}], ",", "x", ",", "Reals"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xMax", "=", 
         RowBox[{"Max", "[", "roots", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xValsForward", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "xMax", ",", 
           RowBox[{"xMax", "/", 
            RowBox[{"(", 
             RowBox[{"resolution", "/", "2"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Trace", " ", "upper", " ", "branch"}], "*)"}], 
        RowBox[{"upperBranch", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"y1", ",", "y2"}], "}"}], "=", 
             RowBox[{"solveYForX", "[", "xval", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"xval", ",", "y1"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"xval", ",", "xValsForward"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Trace", " ", "lower", " ", "branch", " ", "in", " ", "reverse"}], 
         "*)"}], 
        RowBox[{"lowerBranch", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"y1", ",", "y2"}], "}"}], "=", 
             RowBox[{"solveYForX", "[", "xval", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"xval", ",", "y2"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"xval", ",", 
             RowBox[{"Reverse", "[", "xValsForward", "]"}]}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Combine", ",", 
          RowBox[{"removing", " ", "duplicate", " ", "endpoint"}]}], "*)"}], 
        RowBox[{"Join", "[", 
         RowBox[{"upperBranch", ",", 
          RowBox[{"Rest", "[", "lowerBranch", "]"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "tangent", " ", "and", " ", "normal", " ", "for", " ", 
     "implicit", " ", "curve"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeTangentNormalImplicit", "[", "p_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grad", ",", "normGrad", ",", "normal", ",", "tangent"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"grad", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Fx", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"Fy", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"normGrad", "=", 
         RowBox[{"Norm", "[", "grad", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"normGrad", "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", 
            RowBox[{"Null", ",", "Null"}], "}"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"normal", "=", 
         RowBox[{"grad", "/", "normGrad"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tangent", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"normal", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"normal", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"tangent", ",", "normal"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "curvature", " ", "for", " ", "implicit", " ", "curve"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeCurvatureImplicit", "[", "p_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", "y", ",", "fx", ",", "fy", ",", "fxx", ",", "fyy", ",", 
         "fxy", ",", "numerator", ",", "denominator"}], "}"}], ",", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{"p", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", 
        RowBox[{"y", "=", 
         RowBox[{"p", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fx", "=", 
         RowBox[{"Fx", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", 
        RowBox[{"fy", "=", 
         RowBox[{"Fy", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fxx", "=", 
         RowBox[{"Fxx", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", 
        RowBox[{"fyy", "=", 
         RowBox[{"Fyy", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", 
        RowBox[{"fxy", "=", 
         RowBox[{"Fxy", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numerator", "=", 
         RowBox[{
          RowBox[{"fxx", "*", 
           RowBox[{"fy", "^", "2"}]}], "-", 
          RowBox[{"2", "*", "fxy", "*", "fx", "*", "fy"}], "+", 
          RowBox[{"fyy", "*", 
           RowBox[{"fx", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"denominator", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"fx", "^", "2"}], "+", 
            RowBox[{"fy", "^", "2"}]}], ")"}], "^", "1.5"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "denominator", "]"}], "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", "0.0", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"-", "numerator"}], "/", "denominator"}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "focal", " ", "point", " ", "for", " ", "implicit", " ", 
     "curve"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFocalPointImplicit", "[", 
      RowBox[{"p_", ",", 
       RowBox[{"RMax_", ":", " ", "10.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"T", ",", "N", ",", "kappa", ",", "R"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"T", ",", "N"}], "}"}], "=", 
         RowBox[{"computeTangentNormalImplicit", "[", "p", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"N", "===", "Null"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kappa", "=", 
         RowBox[{"computeCurvatureImplicit", "[", "p", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "kappa", "]"}], "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"R", "=", 
         RowBox[{"1.0", "/", "kappa"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "R", "]"}], ">", "RMax"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p", "+", 
         RowBox[{"N", "*", "R"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "focal", " ", "set"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFocalSetImplicit", "[", 
      RowBox[{"points_", ",", 
       RowBox[{"RMax_", ":", " ", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"focalPoints", "=", 
          RowBox[{"{", "}"}]}], ",", "fp"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fp", "=", 
            RowBox[{"computeFocalPointImplicit", "[", 
             RowBox[{"p", ",", "RMax"}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"fp", "=!=", "Null"}], "&&", 
              RowBox[{"VectorQ", "[", 
               RowBox[{"fp", ",", "NumericQ"}], "]"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"focalPoints", ",", "fp"}], "]"}]}], "]"}], ";"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"p", ",", "points"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "focalPoints"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "symmetry", " ", "set"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeSymmetrySetImplicit", "[", 
      RowBox[{"points_", ",", 
       RowBox[{"lambdaMax_", ":", " ", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"centers", "=", 
          RowBox[{"{", "}"}]}], ",", "nPoints", ",", "thresholdIdx", ",", "i",
          ",", "j", ",", "p1", ",", "p2", ",", "T1", ",", "N1", ",", "T2", 
         ",", "N2", ",", "prevCheck1", ",", "prevCheck2", ",", "prevP2", ",", 
         "diff", ",", "Tsum", ",", "Tdiff", ",", "eqCheck1", ",", "eqCheck2", 
         ",", "alpha", ",", "pInterp", ",", "TInterp", ",", "NInterp", ",", 
         "Nvec", ",", "denom", ",", "lam"}], "}"}], ",", 
       RowBox[{
        RowBox[{"nPoints", "=", 
         RowBox[{"Length", "[", "points", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nPoints", "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"thresholdIdx", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"0.05", "*", "nPoints"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p1", "=", 
            RowBox[{"points", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"T1", ",", "N1"}], "}"}], "=", 
            RowBox[{"computeTangentNormalImplicit", "[", "p1", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"T1", "===", "Null"}], ",", 
             RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"prevCheck1", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"prevCheck2", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"prevP2", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"p2", "=", 
               RowBox[{"points", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{
               RowBox[{"{", 
                RowBox[{"T2", ",", "N2"}], "}"}], "=", 
               RowBox[{"computeTangentNormalImplicit", "[", "p2", "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"T2", "===", "Null"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Skip", " ", "if", " ", "tangents", " ", "are", " ", 
                 "parallel", " ", "or", " ", "anti"}], "-", "parallel"}], 
               "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{"T1", "-", "T2"}], "]"}], "<", "1*^-5"}], "||", 
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{"T1", "+", "T2"}], "]"}], "<", "1*^-5"}]}], ",", 
                RowBox[{
                 RowBox[{"prevCheck1", "=", "Null"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"prevCheck2", "=", "Null"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"prevP2", "=", "p2"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Compute", " ", "tangency", " ", "conditions"}], 
               "*)"}], 
              RowBox[{"diff", "=", 
               RowBox[{"p1", "-", "p2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Tsum", "=", 
               RowBox[{"T1", "+", "T2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Tdiff", "=", 
               RowBox[{"T1", "-", "T2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eqCheck1", "=", 
               RowBox[{"diff", ".", "Tsum"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eqCheck2", "=", 
               RowBox[{"diff", ".", "Tdiff"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Check", " ", "for", " ", "sign", " ", "changes"}], 
               "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"prevP2", "=!=", "Null"}], ",", 
                RowBox[{"(*", 
                 RowBox[{"Check", " ", "eq1", " ", "sign", " ", "change"}], 
                 "*)"}], 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"prevCheck1", "=!=", "Null"}], "&&", 
                    RowBox[{
                    RowBox[{"prevCheck1", "*", "eqCheck1"}], "<", "0"}]}], 
                   ",", 
                   RowBox[{
                    RowBox[{"alpha", "=", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck1", "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck1", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck1", "]"}]}], ")"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"pInterp", "=", 
                    RowBox[{"prevP2", "+", 
                    RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{"p2", "-", "prevP2"}], ")"}]}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"TInterp", ",", "NInterp"}], "}"}], "=", 
                    RowBox[{
                    "computeTangentNormalImplicit", "[", "pInterp", "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"NInterp", "=!=", "Null"}], ",", 
                    RowBox[{
                    RowBox[{"Nvec", "=", 
                    RowBox[{"N1", "+", "NInterp"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"denom", "=", 
                    RowBox[{"Nvec", ".", "Nvec"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                    RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"centers", ",", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], "]"}]}], "]"}]}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{"Check", " ", "eq2", " ", "sign", " ", "change"}], 
                  "*)"}], 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"prevCheck2", "=!=", "Null"}], "&&", 
                    RowBox[{
                    RowBox[{"prevCheck2", "*", "eqCheck2"}], "<", "0"}]}], 
                   ",", 
                   RowBox[{
                    RowBox[{"alpha", "=", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck2", "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck2", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck2", "]"}]}], ")"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"pInterp", "=", 
                    RowBox[{"prevP2", "+", 
                    RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{"p2", "-", "prevP2"}], ")"}]}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"TInterp", ",", "NInterp"}], "}"}], "=", 
                    RowBox[{
                    "computeTangentNormalImplicit", "[", "pInterp", "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"NInterp", "=!=", "Null"}], ",", 
                    RowBox[{
                    RowBox[{"Nvec", "=", 
                    RowBox[{"N1", "-", "NInterp"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"denom", "=", 
                    RowBox[{"Nvec", ".", "Nvec"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                    RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"centers", ",", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], "]"}]}], "]"}]}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "previous", " ", "values"}], "*)"}], 
              RowBox[{"prevCheck1", "=", "eqCheck1"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"prevCheck2", "=", "eqCheck2"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"prevP2", "=", "p2"}], ";"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "thresholdIdx"}], ",", "nPoints"}], "}"}]}], 
            "]"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nPoints"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "centers"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", "execution"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<1. Tracing the implicit curve...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"resolution", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"curvePoints", "=", 
     RowBox[{"traceCurveLoop", "[", "resolution", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "curvePoints", "]"}], ",", 
      "\"\< points on the curve.\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<2. Computing focal set...\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"RMax", "=", "10.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"focalPoints", "=", 
     RowBox[{"computeFocalSetImplicit", "[", 
      RowBox[{"curvePoints", ",", "RMax"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "focalPoints", "]"}], ",", 
      "\"\< points in the focal set.\>\""}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<3. Computing symmetry set...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"lambdaMax", "=", "\[Infinity]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"symmetryPoints", "=", 
     RowBox[{"computeSymmetrySetImplicit", "[", 
      RowBox[{"curvePoints", ",", "lambdaMax"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "symmetryPoints", "]"}], ",", 
      "\"\< points in the symmetry set.\>\""}], "]"}], ";"}]}]}]], "Input",
