Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"formattedCurve", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Insert", "[", 
        RowBox[{"#", ",", "\"\<curve\>\"", ",", "1"}], "]"}], "&"}], "/@", 
      "curvePoints"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"formattedFocal", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Insert", "[", 
      RowBox[{"#", ",", "\"\<focal\>\"", ",", "1"}], "]"}], "&"}], "/@", 
    "focalPoints"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formattedSymmetry", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Insert", "[", 
       RowBox[{"#", ",", "\"\<symmetry\>\"", ",", "1"}], "]"}], "&"}], "/@", 
     "centers"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Combine", " ", "all", " ", "data", " ", "into", " ", "one", " ", "big", 
    " ", "list"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allData", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"formattedFocal", ",", "formattedSymmetry"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Add", " ", "a", " ", "header", " ", "row", " ", "for", " ", "clarity", 
    " ", "in", " ", "the", " ", "CSV"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"header", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Type\>\"", ",", "\"\<X\>\"", ",", "\"\<Y\>\""}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exportData", "=", 
   RowBox[{"Prepend", "[", 
    RowBox[{"allData", ",", "header"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<monodromy_fig4.csv\>\"", ",", "exportData"}], "]"}]}], "Input",\

