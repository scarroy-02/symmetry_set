Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"formattedCurve", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Insert", "[", 
      RowBox[{"#", ",", "\"\<curve\>\"", ",", "1"}], "]"}], "&"}], "/@", 
    "curvePoints"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"formattedFocal", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Insert", "[", 
      RowBox[{"#", ",", "\"\<focal\>\"", ",", "1"}], "]"}], "&"}], "/@", 
    "focalPoints"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formattedSymmetry", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Insert", "[", 
       RowBox[{"#", ",", "\"\<symmetry\>\"", ",", "1"}], "]"}], "&"}], "/@", 
     "symmetryPoints"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Combine", " ", "all", " ", "data", " ", "into", " ", "one", " ", "big", 
    " ", "list"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allData", "=", 
    RowBox[{"Join", "[", 
     RowBox[{
     "formattedCurve", ",", "formattedFocal", ",", "formattedSymmetry"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Add", " ", "a", " ", "header", " ", "row", " ", "for", " ", "clarity", 
    " ", "in", " ", "the", " ", "CSV"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"header", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Type\>\"", ",", "\"\<X\>\"", ",", "\"\<Y\>\""}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exportData", "=", 
   RowBox[{"Prepend", "[", 
    RowBox[{"allData", ",", "header"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<potato_plot.csv\>\"", ",", "exportData"}], "]"}]}], "Input",
 CellChangeTimes->{{3.971955056307707*^9, 3.971955092614614*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"5f7a461e-5361-4809-90c3-3abe29948f27"],

