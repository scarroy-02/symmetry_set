Cell[BoxData[{
 RowBox[{
  RowBox[{"circleCenter", "=", 
   RowBox[{"{", 
    RowBox[{"0.628755", ",", "0.013425"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", "0.011"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numPoints", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"circlePlot", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EdgeForm", "[", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Dashed", ",", "Thick"}], "}"}], "]"}], ",", 
       RowBox[{"FaceForm", "[", "None", "]"}], ",", 
       RowBox[{"Circle", "[", 
        RowBox[{"circleCenter", ",", "r"}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"angles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"theta", ",", 
      RowBox[{"{", 
       RowBox[{"theta", ",", "0", ",", 
        RowBox[{
         RowBox[{"2", "*", "Pi"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "*", "Pi"}], ")"}], "/", "numPoints"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "*", "Pi"}], ")"}], "/", "numPoints"}]}], "}"}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
