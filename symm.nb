79ae735b61b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Defining", " ", "the", " ", "parametric", " ", "curve"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"q", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H", "=", "0.8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t_", "]"}], ":=", 
     RowBox[{"a", " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], "-", "1"}], ")"}]}], "-", 
      RowBox[{"H", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "q"}], "*", 
         RowBox[{"t", "^", "2"}]}], "]"}]}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9714935802438726`*^9, 3.971493648755252*^9}, {
   3.971493697428385*^9, 3.97149370720254*^9}, {3.971493807669085*^9, 
