Cell[CellGroupData[{

Cell["Symmetry set from implicit curves", "Subtitle",
 CellChangeTimes->{{3.971521954685066*^9, 
  3.971521971814397*^9}},ExpressionUUID->"6ef6c3c7-7b1d-4d3a-9fdb-\
4286ef3143bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "constants", " ", "for", " ", "the", " ", "implicit", " ", 
    "curve"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"1025", "/", "1000"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b", "=", 
     RowBox[{"9", "/", "100"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a2", "=", 
     RowBox[{"a", "^", "2"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Implicit", " ", "curve", " ", "equation", " ", "F", 
      RowBox[{"(", 
       RowBox[{"x", ",", "y"}], ")"}]}], "=", 
     RowBox[{"0", "-", 
      RowBox[{"as", " ", "numerical", " ", "functions"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"y", "^", "2"}], "-", 
      RowBox[{"2", "*", "b", "*", "x", "*", "y"}], "-", 
      RowBox[{"a2", "*", "x"}], "+", 
      RowBox[{"a2", "*", 
       RowBox[{"x", "^", "3"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Partial", " ", "derivatives"}], "-", 
     RowBox[{"computed", " ", "numerically"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Fx", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", "b", "*", "y"}], "-", "a2", "+", 
      RowBox[{"3", "*", "a2", "*", 
       RowBox[{"x", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fy", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "*", "y"}], "-", 
      RowBox[{"2", "*", "b", "*", "x"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fxx", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"6", "*", "a2", "*", "x"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fyy", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", "2.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fxy", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "2.0"}], "*", "b"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "for", " ", "y", " ", "given", " ", "x"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"solveYForX", "[", 
      RowBox[{"xval_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"discriminant", ",", "sqrtD", ",", "y1", ",", "y2"}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"discriminant", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "b", "*", "xval"}], ")"}], "^", "2"}], "-", 
          RowBox[{"4", "*", "1", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "a2"}], "*", "xval"}], "+", 
             RowBox[{"a2", "*", 
              RowBox[{"xval", "^", "3"}]}]}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"discriminant", "<", "1*^-9"}], ",", 
          RowBox[{"discriminant", "=", "0"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sqrtD", "=", 
         RowBox[{"Sqrt", "[", "discriminant", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"y1", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "b", "*", "xval"}], "+", "sqrtD"}], ")"}], "/", 
          "2.0"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"y2", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "b", "*", "xval"}], "-", "sqrtD"}], ")"}], "/", 
          "2.0"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"y1", ",", "y2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Adaptive", " ", "sampling", " ", "function"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"adaptiveXSampling", "[", 
      RowBox[{"xMax_", ",", 
       RowBox[{"baseResolution_", ":", "800"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "region1", ",", "region2", ",", "region3", ",", "region4", ",", 
         "region5", ",", "nDense", ",", "nSparse"}], "}"}], ",", 
       RowBox[{
        RowBox[{"nDense", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"baseResolution", "*", "1.5"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "Dense", " ", "sampling", " ", "for", " ", "special", " ", 
          "regions"}], "*)"}], 
        RowBox[{"nSparse", "=", 
         RowBox[{"Floor", "[", "baseResolution", "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "Sparse", " ", "sampling", " ", "for", " ", "other", " ", 
          "regions"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Dense", " ", "sampling", " ", "near", " ", "0"}], ":", 
          RowBox[{
           RowBox[{"[", 
            RowBox[{
             RowBox[{"-", "0.02"}], ",", "0.02"}], "]"}], "-", 
           RowBox[{"adjust", " ", "start", " ", "if", " ", "negative"}]}]}], 
         "*)"}], 
        RowBox[{"region1", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", 
             RowBox[{"-", "0.02"}]}], "]"}], ",", "0.02", ",", 
           RowBox[{"0.04", "/", "nDense"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Sparse", " ", 
          RowBox[{"sampling", ":", 
           RowBox[{"(", 
            RowBox[{"0.02", ",", "0.98"}], ")"}]}]}], "*)"}], 
        RowBox[{"region2", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"0.02", "+", 
            RowBox[{"0.96", "/", "nSparse"}]}], ",", "0.98", ",", 
           RowBox[{"0.96", "/", "nSparse"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Dense", " ", "sampling", " ", "near", " ", "1"}], ":", 
          RowBox[{"[", 
           RowBox[{"0.98", ",", "1.02"}], "]"}]}], "*)"}], 
        RowBox[{"region3", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"0.98", ",", 
           RowBox[{"Min", "[", 
            RowBox[{"1.02", ",", "xMax"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"0.04", ",", 
              RowBox[{"1.02", "-", "0.98"}]}], "]"}], "/", "nDense"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Sparse", " ", "sampling", " ", "from", " ", "1.02", " ", "to", " ",
            "xMax", " ", "if", " ", "xMax"}], ">", "1.02"}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"xMax", ">", "1.02"}], ",", 
          RowBox[{
           RowBox[{"region4", "=", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"1.02", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"xMax", "-", "1.02"}], ")"}], "/", "nSparse"}]}], 
              ",", "xMax", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"xMax", "-", "1.02"}], ")"}], "/", "nSparse"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"region5", "=", 
            RowBox[{"{", "}"}]}]}], ",", 
          RowBox[{
           RowBox[{"region4", "=", 
            RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"region5", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"xMax", ">", "1.02"}], ",", 
              RowBox[{"{", "}"}], ",", 
              RowBox[{"Range", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", "region3", "]"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"xMax", "-", 
                    RowBox[{"Max", "[", "region3", "]"}]}], ")"}], "/", 
                  "nSparse"}]}], ",", "xMax", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"xMax", "-", 
                   RowBox[{"Max", "[", "region3", "]"}]}], ")"}], "/", 
                 "nSparse"}]}], "]"}]}], "]"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Combine", " ", "and", " ", "remove", " ", "duplicates"}], 
         "*)"}], 
        RowBox[{"Union", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
          "region1", ",", "region2", ",", "region3", ",", "region4", ",", 
           "region5"}], "]"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Trace", " ", "the", " ", "curve", " ", "loop", " ", "with", " ", 
     "adaptive", " ", "sampling"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"traceCurveLoop", "[", 
      RowBox[{"resolution_", ":", "800"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "roots", ",", "xMax", ",", "xValsForward", ",", "upperBranch", ",", 
         "lowerBranch", ",", "y1", ",", "y2"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
          "Find", " ", "the", " ", "positive", " ", "root", " ", "of"}], "-", 
          
          RowBox[{
           RowBox[{"a", "^", "2"}], "*", 
           RowBox[{"x", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"b", "^", "2"}], "*", "x"}], "+", 
          RowBox[{"a", "^", "2"}]}], "=", "0"}], "*)"}], 
       RowBox[{
        RowBox[{"roots", "=", 
         RowBox[{"x", "/.", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "a2"}], "*", 
               RowBox[{"x", "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{"b", "^", "2"}], "*", "x"}], "+", "a2"}], "\[Equal]", 
             "0"}], ",", "x", ",", "Reals"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xMax", "=", 
         RowBox[{"Max", "[", "roots", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Use", " ", "adaptive", " ", "sampling"}], "*)"}], 
        RowBox[{"xValsForward", "=", 
         RowBox[{"adaptiveXSampling", "[", 
          RowBox[{"xMax", ",", "resolution"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Trace", " ", "upper", " ", "branch"}], "*)"}], 
        RowBox[{"upperBranch", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"y1", ",", "y2"}], "}"}], "=", 
             RowBox[{"solveYForX", "[", "xval", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"xval", ",", "y1"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"xval", ",", "xValsForward"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Trace", " ", "lower", " ", "branch", " ", "in", " ", "reverse"}], 
         "*)"}], 
        RowBox[{"lowerBranch", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"y1", ",", "y2"}], "}"}], "=", 
             RowBox[{"solveYForX", "[", "xval", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"xval", ",", "y2"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"xval", ",", 
             RowBox[{"Reverse", "[", "xValsForward", "]"}]}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Combine", ",", 
          RowBox[{"removing", " ", "duplicate", " ", "endpoint"}]}], "*)"}], 
        RowBox[{"Join", "[", 
         RowBox[{"upperBranch", ",", 
          RowBox[{"Rest", "[", "lowerBranch", "]"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "tangent", " ", "and", " ", "normal", " ", "for", " ", 
     "implicit", " ", "curve"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeTangentNormalImplicit", "[", "p_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grad", ",", "normGrad", ",", "normal", ",", "tangent"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"grad", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Fx", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"Fy", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"normGrad", "=", 
         RowBox[{"Norm", "[", "grad", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"normGrad", "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", 
            RowBox[{"Null", ",", "Null"}], "}"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"normal", "=", 
         RowBox[{"grad", "/", "normGrad"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tangent", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"normal", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"normal", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"tangent", ",", "normal"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "curvature", " ", "for", " ", "implicit", " ", "curve"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeCurvatureImplicit", "[", "p_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", "y", ",", "fx", ",", "fy", ",", "fxx", ",", "fyy", ",", 
         "fxy", ",", "numerator", ",", "denominator"}], "}"}], ",", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{"p", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", 
        RowBox[{"y", "=", 
         RowBox[{"p", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fx", "=", 
         RowBox[{"Fx", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", 
        RowBox[{"fy", "=", 
         RowBox[{"Fy", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fxx", "=", 
         RowBox[{"Fxx", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", 
        RowBox[{"fyy", "=", 
         RowBox[{"Fyy", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", 
        RowBox[{"fxy", "=", 
         RowBox[{"Fxy", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numerator", "=", 
         RowBox[{
          RowBox[{"fxx", "*", 
           RowBox[{"fy", "^", "2"}]}], "-", 
          RowBox[{"2", "*", "fxy", "*", "fx", "*", "fy"}], "+", 
          RowBox[{"fyy", "*", 
           RowBox[{"fx", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"denominator", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"fx", "^", "2"}], "+", 
            RowBox[{"fy", "^", "2"}]}], ")"}], "^", "1.5"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "denominator", "]"}], "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", "0.0", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"-", "numerator"}], "/", "denominator"}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "focal", " ", "point", " ", "for", " ", "implicit", " ", 
     "curve"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFocalPointImplicit", "[", 
      RowBox[{"p_", ",", 
       RowBox[{"RMax_", ":", " ", "10.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"T", ",", "N", ",", "kappa", ",", "R"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"T", ",", "N"}], "}"}], "=", 
         RowBox[{"computeTangentNormalImplicit", "[", "p", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"N", "===", "Null"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kappa", "=", 
         RowBox[{"computeCurvatureImplicit", "[", "p", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "kappa", "]"}], "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"R", "=", 
         RowBox[{"1.0", "/", "kappa"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "R", "]"}], ">", "RMax"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p", "+", 
         RowBox[{"N", "*", "R"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "focal", " ", "set"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFocalSetImplicit", "[", 
      RowBox[{"points_", ",", 
       RowBox[{"RMax_", ":", " ", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"focalPoints", "=", 
          RowBox[{"{", "}"}]}], ",", "fp"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fp", "=", 
            RowBox[{"computeFocalPointImplicit", "[", 
             RowBox[{"p", ",", "RMax"}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"fp", "=!=", "Null"}], "&&", 
