Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Import", " ", "the", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Import", "[", "\"\<potato_plot.csv\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Parse", " ", "the", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"curvePoints", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<curve\>\""}], 
         "&"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;", "3"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"symmetryPoints", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<symmetry\>\""}], 
         "&"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;", "3"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"focalPoints", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<focal\>\""}], 
         "&"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;", "3"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "animation", " ", "frames"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalSymmetryPoints", "=", 
     RowBox[{"Length", "[", "symmetryPoints", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totalFocalPoints", "=", 
     RowBox[{"Length", "[", "focalPoints", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Determine", " ", "plot", " ", "range", " ", "from", " ", "all", " ", 
     "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allPoints", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"curvePoints", ",", "symmetryPoints", ",", "focalPoints"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xRange", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"allPoints", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"allPoints", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"yRange", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"allPoints", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"allPoints", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"padding", "=", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"plotRange", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"xRange", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "padding"}], ",", 
         RowBox[{
          RowBox[{"xRange", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "+", "padding"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"yRange", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "padding"}], ",", 
         RowBox[{
          RowBox[{"yRange", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "+", "padding"}]}], "}"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Create", " ", "animation"}], "-", 
     RowBox[{
     "plotting", " ", "symmetry", " ", "and", " ", "focal", " ", "points", 
      " ", "progressively"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frames", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{"(*", 
         RowBox[{
         "Always", " ", "show", " ", "the", " ", "full", " ", "curve"}], 
         "*)"}], 
        RowBox[{
         RowBox[{"ListPlot", "[", 
          RowBox[{"curvePoints", ",", 
           RowBox[{"PlotStyle", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
           RowBox[{"Joined", "\[Rule]", "True"}]}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "Show", " ", "symmetry", " ", "points", " ", "up", " ", "to", " ", 
           "frame", " ", "i"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[LessEqual]", "totalSymmetryPoints"}], ",", 
           RowBox[{"ListPlot", "[", 
            RowBox[{
             RowBox[{"symmetryPoints", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", "i"}], "]"}], "]"}], ",", 
             RowBox[{"PlotStyle", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"Red", ",", 
                RowBox[{"PointSize", "[", "0.008", "]"}]}], "}"}]}]}], "]"}], 
           ",", 
           RowBox[{"ListPlot", "[", 
            RowBox[{"symmetryPoints", ",", 
             RowBox[{"PlotStyle", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"Red", ",", 
                RowBox[{"PointSize", "[", "0.008", "]"}]}], "}"}]}]}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "Show", " ", "focal", " ", "points", " ", "after", " ", "symmetry", 
           " ", "points", " ", "are", " ", "done"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", ">", "totalSymmetryPoints"}], ",", 
           RowBox[{"ListPlot", "[", 
            RowBox[{
             RowBox[{"focalPoints", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"Min", "[", 
                 RowBox[{
                  RowBox[{"i", "-", "totalSymmetryPoints"}], ",", 
                  "totalFocalPoints"}], "]"}]}], "]"}], "]"}], ",", 
             RowBox[{"PlotStyle", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"Green", ",", 
                RowBox[{"PointSize", "[", "0.008", "]"}]}], "}"}]}]}], "]"}], 
           ",", 
           RowBox[{"Graphics", "[", 
            RowBox[{"{", "}"}], "]"}]}], "]"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "plotRange"}], ",", 
         RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
         RowBox[{"Frame", "\[Rule]", "True"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "\[LessEqual]", "totalSymmetryPoints"}], ",", 
            RowBox[{"StringForm", "[", 
             RowBox[{
             "\"\<Symmetry Set: `` / `` points\>\"", ",", "i", ",", 
              "totalSymmetryPoints"}], "]"}], ",", 
            RowBox[{"StringForm", "[", 
             RowBox[{
             "\"\<Symmetry: `` | Focal: `` / ``\>\"", ",", 
              "totalSymmetryPoints", ",", 
              RowBox[{"i", "-", "totalSymmetryPoints"}], ",", 
              "totalFocalPoints"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"totalSymmetryPoints", "+", "totalFocalPoints"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"Floor", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"totalSymmetryPoints", "+", "totalFocalPoints"}], ")"}],
              "/", "200"}], "]"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Export", " ", "as", " ", "animated", " ", "GIF"}], "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<potato_symmetry_animation.gif\>\"", ",", "frames", ",", 
      RowBox[{"\"\<DisplayDurations\>\"", "\[Rule]", "0.05"}], ",", 
      RowBox[{"\"\<AnimationRepetitions\>\"", "\[Rule]", "Infinity"}]}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Animation created!\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total symmetry points: \>\"", ",", "totalSymmetryPoints"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total focal points: \>\"", ",", "totalFocalPoints"}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Also", " ", "create", " ", "a", " ", "final", " ", "static", " ", 
     "plot"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"finalPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"curvePoints", ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
         RowBox[{"Joined", "\[Rule]", "True"}], ",", 
         RowBox[{"PlotLegends", "\[Rule]", 
          RowBox[{"{", "\"\<Curve\>\"", "}"}]}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"symmetryPoints", ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Red", ",", 
            RowBox[{"PointSize", "[", "0.006", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "\[Rule]", 
          RowBox[{"{", "\"\<Symmetry Set\>\"", "}"}]}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"focalPoints", ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Green", ",", 
            RowBox[{"PointSize", "[", "0.006", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "\[Rule]", 
          RowBox[{"{", "\"\<Focal Set\>\"", "}"}]}]}], "]"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "plotRange"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{
       "PlotLabel", "\[Rule]", "\"\<Complete Symmetry and Focal Sets\>\""}], 
       ",", 
       RowBox[{"ImageSize", "\[Rule]", "700"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<potato_complete_plot.png\>\"", ",", "finalPlot"}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Static plot saved!\>\"", "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.971502436720393*^9, 3.9715024496409693`*^9}, {
  3.971514428904298*^9, 3.9715144511715384`*^9}, {3.972106404460925*^9, 
