79ae735b61b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Defining", " ", "the", " ", "parametric", " ", "curve"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"a", "=", "1.5"}], ";", "\[IndentingNewLine]", 
    RowBox[{"b", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"q", "=", "20"}], ";", "\[IndentingNewLine]", 
    RowBox[{"H", "=", "1.1"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "[", "t_", "]"}], ":=", 
     RowBox[{"a", " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"y", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], "-", "1"}], ")"}]}], "-", 
      RowBox[{"H", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "q"}], "*", 
         RowBox[{"t", "^", "2"}]}], "]"}]}]}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Cos", "[", "t", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"-", "0.55"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "20"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", "-", "2"}], ")"}], "^", "2"}]}], "]"}]}], "+", 
        RowBox[{"0.6", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "70"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", "-", "2.4"}], ")"}], "^", "2"}]}], "]"}]}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "[", "t_", "]"}], ":=", 
     RowBox[{"1.8", 
      RowBox[{"Sin", "[", "t", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"-", "0.55"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "20"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", "-", "2"}], ")"}], "^", "2"}]}], "]"}]}], "+", 
        RowBox[{"0.6", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "70"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", "-", "2.4"}], ")"}], "^", "2"}]}], "]"}]}]}], 
       ")"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9714935802438726`*^9, 3.971493648755252*^9}, {
