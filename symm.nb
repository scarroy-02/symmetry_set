Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", "1.025"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p", "=", "0.09"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"y", "^", "2"}], "-", 
     RowBox[{"2", " ", "p", " ", "x", " ", "y"}]}], "\[Equal]", 
    RowBox[{
     RowBox[{"m", "^", "2"}], 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       RowBox[{"x", "^", "3"}]}], ")"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1.5"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"ContourStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", "\"\<y\.b2 - 2bxy = a\.b2(x - x\.b3)\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "600"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "100"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9715087955927*^9, 3.971509012986809*^9}, {
