         ",", "alpha", ",", "pInterp", ",", "TInterp", ",", "NInterp", ",", 
         "Nvec", ",", "denom", ",", "lam"}], "}"}], ",", 
       RowBox[{
        RowBox[{"nPoints", "=", 
         RowBox[{"Length", "[", "points", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nPoints", "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"thresholdIdx", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"0.05", "*", "nPoints"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p1", "=", 
            RowBox[{"points", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"T1", ",", "N1"}], "}"}], "=", 
            RowBox[{"computeTangentNormalImplicit", "[", "p1", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"T1", "===", "Null"}], ",", 
             RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"prevCheck1", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"prevCheck2", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"prevP2", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"p2", "=", 
               RowBox[{"points", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{
               RowBox[{"{", 
                RowBox[{"T2", ",", "N2"}], "}"}], "=", 
               RowBox[{"computeTangentNormalImplicit", "[", "p2", "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"T2", "===", "Null"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Skip", " ", "if", " ", "tangents", " ", "are", " ", 
                 "parallel", " ", "or", " ", "anti"}], "-", "parallel"}], 
               "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{"T1", "-", "T2"}], "]"}], "<", "1*^-5"}], "||", 
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{"T1", "+", "T2"}], "]"}], "<", "1*^-5"}]}], ",", 
                RowBox[{
                 RowBox[{"prevCheck1", "=", "Null"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"prevCheck2", "=", "Null"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"prevP2", "=", "p2"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Compute", " ", "tangency", " ", "conditions"}], 
               "*)"}], 
              RowBox[{"diff", "=", 
               RowBox[{"p1", "-", "p2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Tsum", "=", 
               RowBox[{"T1", "+", "T2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Tdiff", "=", 
               RowBox[{"T1", "-", "T2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eqCheck1", "=", 
               RowBox[{"diff", ".", "Tsum"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eqCheck2", "=", 
               RowBox[{"diff", ".", "Tdiff"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Check", " ", "for", " ", "sign", " ", "changes"}], 
               "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"prevP2", "=!=", "Null"}], ",", 
                RowBox[{"(*", 
                 RowBox[{"Check", " ", "eq1", " ", "sign", " ", "change"}], 
                 "*)"}], 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"prevCheck1", "=!=", "Null"}], "&&", 
                    RowBox[{
                    RowBox[{"prevCheck1", "*", "eqCheck1"}], "<", "0"}]}], 
                   ",", 
                   RowBox[{
                    RowBox[{"alpha", "=", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck1", "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck1", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck1", "]"}]}], ")"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"pInterp", "=", 
                    RowBox[{"prevP2", "+", 
                    RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{"p2", "-", "prevP2"}], ")"}]}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"TInterp", ",", "NInterp"}], "}"}], "=", 
                    RowBox[{
                    "computeTangentNormalImplicit", "[", "pInterp", "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"NInterp", "=!=", "Null"}], ",", 
                    RowBox[{
                    RowBox[{"Nvec", "=", 
                    RowBox[{"N1", "+", "NInterp"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"denom", "=", 
                    RowBox[{"Nvec", ".", "Nvec"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                    RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"centers", ",", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], "]"}]}], "]"}]}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{"Check", " ", "eq2", " ", "sign", " ", "change"}], 
                  "*)"}], 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"prevCheck2", "=!=", "Null"}], "&&", 
                    RowBox[{
                    RowBox[{"prevCheck2", "*", "eqCheck2"}], "<", "0"}]}], 
                   ",", 
                   RowBox[{
                    RowBox[{"alpha", "=", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck2", "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck2", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck2", "]"}]}], ")"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"pInterp", "=", 
                    RowBox[{"prevP2", "+", 
                    RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{"p2", "-", "prevP2"}], ")"}]}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"TInterp", ",", "NInterp"}], "}"}], "=", 
                    RowBox[{
                    "computeTangentNormalImplicit", "[", "pInterp", "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"NInterp", "=!=", "Null"}], ",", 
                    RowBox[{
                    RowBox[{"Nvec", "=", 
                    RowBox[{"N1", "-", "NInterp"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"denom", "=", 
                    RowBox[{"Nvec", ".", "Nvec"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                    RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"centers", ",", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], "]"}]}], "]"}]}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "previous", " ", "values"}], "*)"}], 
              RowBox[{"prevCheck1", "=", "eqCheck1"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"prevCheck2", "=", "eqCheck2"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"prevP2", "=", "p2"}], ";"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "thresholdIdx"}], ",", "nPoints"}], "}"}]}], 
            "]"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nPoints"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "centers"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", "execution"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<1. Tracing the implicit curve...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"resolution", "=", "2000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"curvePoints", "=", 
     RowBox[{"traceCurveLoop", "[", "resolution", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "curvePoints", "]"}], ",", 
