Cell[BoxData[{
 RowBox[{
  RowBox[{"circleCenter", "=", 
   RowBox[{"{", 
    RowBox[{"0.628755", ",", "0.013425"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", "0.011"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numPoints", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"circlePlot", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EdgeForm", "[", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Dashed", ",", "Thick"}], "}"}], "]"}], ",", 
       RowBox[{"FaceForm", "[", "None", "]"}], ",", 
       RowBox[{"Circle", "[", 
        RowBox[{"circleCenter", ",", "r"}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"angles", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"theta", ",", 
      RowBox[{"{", 
       RowBox[{"theta", ",", "0", ",", 
        RowBox[{
         RowBox[{"2", "*", "Pi"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "*", "Pi"}], ")"}], "/", "numPoints"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "*", "Pi"}], ")"}], "/", "numPoints"}]}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sampledCirclePoints", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"circleCenter", "+", 
       RowBox[{"r", "*", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "a", "]"}], ",", 
          RowBox[{"Sin", "[", "a", "]"}]}], "}"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "angles"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sampledPointsPlot", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"sampledCirclePoints", ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Black", ",", 
         RowBox[{"PointSize", "[", "0.001", "]"}], ",", 
         RowBox[{"AbsoluteThickness", "[", ".0001", "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"CapForm", "[", "\"\<Butt\>\"", "]"}], ",", 
           RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}], ",", 
         RowBox[{"PlotMarkers", "\[Rule]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], 
           "]"}]}]}], " ", "}"}]}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", "\"\<Sampled Points\>\"", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Right", ",", "Top"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"plot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{"curvePoints", ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
      RowBox[{"Joined", "\[Rule]", "True"}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", "\"\<Curve\>\"", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Right", ",", "Top"}], "}"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"focalPoints", ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Darker", "[", "Green", "]"}], ",", 
         RowBox[{"PointSize", "[", "0.000001", "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", "\"\<Focal Set\>\"", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Right", ",", "Top"}], "}"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"ListPlot", "[", 
