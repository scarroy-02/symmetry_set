Cell[CellGroupData[{

Cell["Spiral ", "Subsubsection",
 CellChangeTimes->{{3.9716943000130863`*^9, 
  3.9716943018074245`*^9}},ExpressionUUID->"e46deaeb-c42f-2b4e-84e1-\
1535f01cdcae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Clear", " ", "all", " ", "previous", " ", 
     RowBox[{"definitions", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Define", " ", "Parameters", " ", "for", 
      " ", "an", " ", "INWARD", " ", 
      RowBox[{"spiral", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", "0.2"}], ";", 
    RowBox[{"(*", 
     RowBox[{"Growth", " ", "rate", " ", 
      RowBox[{"(", 
       RowBox[{"controls", " ", "\"\<tightness\>\""}], ")"}]}], "*)"}], 
    RowBox[{"tmin", "=", "3.5"}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Starting", " ", "angle", " ", 
       RowBox[{"(", "t", ")"}], " ", "in", " ", "radians"}], "-", 
      RowBox[{"This", " ", "is", " ", "the", " ", "OUTER", " ", "end"}]}], 
     "*)"}], 
    RowBox[{"tmax", "=", 
     RowBox[{"tmin", "+", 
      RowBox[{"3.5", "*", "Pi"}]}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Ending", " ", "angle", " ", 
       RowBox[{"(", "t", ")"}]}], "-", 
      RowBox[{"This", " ", "is", " ", "the", " ", "INNER", " ", "end"}]}], 
     "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "We"}]}], " ", "want", " ", "the", " ", "outer", " ", 
       "radii", " ", "to", " ", "be", " ", "a", " ", "certain", " ", "size", 
       " ", "at", " ", 
       RowBox[{"tmin", "--"}]}], "-"}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Let", "'"}], "s", " ", "set", " ", "the", " ", "outer", " ", 
      "radius", " ", 
      RowBox[{"(", "R", ")"}], " ", "and", " ", "thickness"}], "*)"}], 
    RowBox[{"ROuter", "=", "4.5"}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Desired", " ", "radius", " ", "of", " ", "the", " ", "outer"}],
       "-", 
      RowBox[{"most", " ", "curve", " ", "at", " ", "the", " ", "start"}]}], 
     "*)"}], 
    RowBox[{"thickness", "=", "0.3"}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "Desired", " ", "thickness", " ", "of", " ", "the", " ", "hollow", " ", 
      "shape"}], "*)"}], 
    RowBox[{"RInner", "=", 
     RowBox[{"ROuter", "-", "thickness"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Calculate"}]}], " ", 
      RowBox[{"the", "'"}], 
      RowBox[{"a", "'"}], " ", "scaling", " ", "factors", " ", "to", " ", 
      "get", " ", "these", " ", 
      RowBox[{"radii", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"R", "=", 
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "tmin"}], "]"}]}], "=", 
      RowBox[{
       RowBox[{">", "a"}], "=", 
       RowBox[{"R", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"b", "*", "tmin"}], "]"}]}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aOuter", "=", 
     RowBox[{"ROuter", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"b", "*", "tmin"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aInner", "=", 
     RowBox[{"RInner", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"b", "*", "tmin"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "3."}]}], " ", "Define", " ", "the", " ", "INWARD", " ", 
      "Spiral", " ", 
      RowBox[{"Equations", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Note", " ", "the", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "b"}], "*", "t"}], "]"}], " ", "to", " ", "spiral", " ", 
     "INWARDS"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"innerSpiral", "[", "t_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"aInner", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Cos", "[", "t", "]"}]}], ",", 
      RowBox[{"aInner", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}]}], "\n", 
   RowBox[{
    RowBox[{"outerSpiral", "[", "t_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"aOuter", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Cos", "[", "t", "]"}]}], ",", 
      RowBox[{"aOuter", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], "*", "t"}], "]"}], "*", 
       RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "Define", " ", "the", " ", "Rounded", " ", 
      "End", " ", "Cap", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"at", " ", "the", " ", "start"}], ",", 
         RowBox[{"t", "=", "tmin"}]}], ")"}], "--"}]}], "-"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{"innerSpiral", "[", "tmin", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p2", "=", 
     RowBox[{"outerSpiral", "[", "tmin", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"center", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p1", "+", "p2"}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"radius", "=", 
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{"p2", "-", "p1"}], "]"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"endCap", "[", "s_", "]"}], ":=", 
    RowBox[{"center", "+", 
     RowBox[{"radius", "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"s", "+", "tmin", "+", 
          RowBox[{"Pi", "/", "2"}]}], "]"}], ",", 
        RowBox[{"Sin", "[", 
         RowBox[{"s", "+", "tmin", "+", 
          RowBox[{"Pi", "/", "2"}]}], "]"}]}], "}"}]}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "5."}]}], " ", "Generate", " ", "the", " ", 
      RowBox[{"Plots", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotInner", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"innerSpiral", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.7", ",", "0.4", ",", "0.3"}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOuter", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"outerSpiral", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.7", ",", "0.4", ",", "0.3"}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotCap", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"endCap", "[", "s", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.7", ",", "0.4", ",", "0.3"}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "6."}]}], " ", "Combine", " ", "and", " ", "Style", " ", 
      RowBox[{"Everything", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"plotInner", ",", "plotOuter", ",", "plotCap"}], "}"}], ",", 
     RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"GridLinesStyle", "\[Rule]", "LightGray"}], ",", 
     RowBox[{"Axes", "\[Rule]", "True"}], ",", 
     RowBox[{"AxesOrigin", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"AxesStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Green"}], "}"}]}], ",", 
     RowBox[{"Frame", "\[Rule]", "False"}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}]}]], "Input",
