              RowBox[{"diff", "=", 
               RowBox[{"p1", "-", "p2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Tsum", "=", 
               RowBox[{"T1", "+", "T2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Tdiff", "=", 
               RowBox[{"T1", "-", "T2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eqCheck1", "=", 
               RowBox[{"diff", ".", "Tsum"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eqCheck2", "=", 
               RowBox[{"diff", ".", "Tdiff"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Check", " ", "for", " ", "sign", " ", "changes"}], 
               "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"prevP2", "=!=", "Null"}], ",", 
                RowBox[{"(*", 
                 RowBox[{"Check", " ", "eq1", " ", "sign", " ", "change"}], 
                 "*)"}], 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"prevCheck1", "=!=", "Null"}], "&&", 
                    RowBox[{
                    RowBox[{"prevCheck1", "*", "eqCheck1"}], "<", "0"}]}], 
                   ",", 
                   RowBox[{
                    RowBox[{"alpha", "=", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck1", "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck1", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck1", "]"}]}], ")"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"pInterp", "=", 
                    RowBox[{"prevP2", "+", 
                    RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{"p2", "-", "prevP2"}], ")"}]}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"TInterp", ",", "NInterp"}], "}"}], "=", 
                    RowBox[{
                    "computeTangentNormalImplicit", "[", "pInterp", "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"NInterp", "=!=", "Null"}], ",", 
                    RowBox[{
                    RowBox[{"Nvec", "=", 
                    RowBox[{"N1", "+", "NInterp"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"denom", "=", 
                    RowBox[{"Nvec", ".", "Nvec"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                    RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"centers", ",", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], "]"}]}], "]"}]}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{"Check", " ", "eq2", " ", "sign", " ", "change"}], 
                  "*)"}], 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"prevCheck2", "=!=", "Null"}], "&&", 
                    RowBox[{
                    RowBox[{"prevCheck2", "*", "eqCheck2"}], "<", "0"}]}], 
                   ",", 
                   RowBox[{
                    RowBox[{"alpha", "=", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck2", "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", "prevCheck2", "]"}], "+", 
                    RowBox[{"Abs", "[", "eqCheck2", "]"}]}], ")"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"pInterp", "=", 
                    RowBox[{"prevP2", "+", 
                    RowBox[{"alpha", "*", 
                    RowBox[{"(", 
                    RowBox[{"p2", "-", "prevP2"}], ")"}]}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"TInterp", ",", "NInterp"}], "}"}], "=", 
                    RowBox[{
                    "computeTangentNormalImplicit", "[", "pInterp", "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"NInterp", "=!=", "Null"}], ",", 
                    RowBox[{
                    RowBox[{"Nvec", "=", 
                    RowBox[{"N1", "-", "NInterp"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"denom", "=", 
                    RowBox[{"Nvec", ".", "Nvec"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "denom", "]"}], ">", "1*^-8"}], ",", 
                    RowBox[{
                    RowBox[{"lam", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"pInterp", "-", "p1"}], ")"}], ".", "Nvec"}], "/",
                     "denom"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "lam", "]"}], "<", "lambdaMax"}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"centers", ",", 
                    RowBox[{"p1", "+", 
                    RowBox[{"lam", "*", "N1"}]}]}], "]"}]}], "]"}]}]}], 
                    "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "previous", " ", "values"}], "*)"}], 
              RowBox[{"prevCheck1", "=", "eqCheck1"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"prevCheck2", "=", "eqCheck2"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"prevP2", "=", "p2"}], ";"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "thresholdIdx"}], ",", "nPoints"}], "}"}]}], 
            "]"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nPoints"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "centers"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", "execution"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<1. Tracing the implicit curve...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"resolution", "=", "2000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"curvePoints", "=", 
     RowBox[{"traceCurveLoop", "[", "resolution", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "curvePoints", "]"}], ",", 
      "\"\< points on the curve.\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<2. Computing focal set...\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"RMax", "=", "10.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"focalPoints", "=", 
     RowBox[{"computeFocalSetImplicit", "[", 
      RowBox[{"curvePoints", ",", "RMax"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
