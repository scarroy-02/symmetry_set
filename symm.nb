Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", "t", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"-", "0.55"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "20"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "2"}], ")"}], "^", "2"}]}], "]"}]}], "+", 
      RowBox[{"0.6", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "70"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "2.4"}], ")"}], "^", "2"}]}], "]"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "t_", "]"}], ":=", 
   RowBox[{"1.8", 
    RowBox[{"Sin", "[", "t", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"-", "0.55"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "20"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "2"}], ")"}], "^", "2"}]}], "]"}]}], "+", 
      RowBox[{"0.6", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "70"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "2.4"}], ")"}], "^", "2"}]}], "]"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", "\"\<Curve\>\"", "}"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2.2"}], ",", "2.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "700"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "p", "]"}], ",", 
       RowBox[{"Sin", "[", "p", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", 
       RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Thick"}], "}"}]}], ",", 
