               RowBox[{"fp", ",", "NumericQ"}], "]"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"focalPoints", ",", "fp"}], "]"}]}], "]"}], ";"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"p", ",", "points"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "focalPoints"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "symmetry", " ", "set"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeSymmetrySetImplicit", "[", 
      RowBox[{"points_", ",", 
       RowBox[{"lambdaMax_", ":", " ", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"centers", "=", 
          RowBox[{"{", "}"}]}], ",", "nPoints", ",", "thresholdIdx", ",", "i",
          ",", "j", ",", "p1", ",", "p2", ",", "T1", ",", "N1", ",", "T2", 
         ",", "N2", ",", "prevCheck1", ",", "prevCheck2", ",", "prevP2", ",", 
         "diff", ",", "Tsum", ",", "Tdiff", ",", "eqCheck1", ",", "eqCheck2", 
         ",", "alpha", ",", "pInterp", ",", "TInterp", ",", "NInterp", ",", 
         "Nvec", ",", "denom", ",", "lam"}], "}"}], ",", 
       RowBox[{
        RowBox[{"nPoints", "=", 
         RowBox[{"Length", "[", "points", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nPoints", "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"thresholdIdx", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"0.05", "*", "nPoints"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p1", "=", 
            RowBox[{"points", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"T1", ",", "N1"}], "}"}], "=", 
            RowBox[{"computeTangentNormalImplicit", "[", "p1", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"T1", "===", "Null"}], ",", 
             RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"prevCheck1", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"prevCheck2", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"prevP2", "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"p2", "=", 
               RowBox[{"points", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{
               RowBox[{"{", 
                RowBox[{"T2", ",", "N2"}], "}"}], "=", 
               RowBox[{"computeTangentNormalImplicit", "[", "p2", "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"T2", "===", "Null"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Skip", " ", "if", " ", "tangents", " ", "are", " ", 
                 "parallel", " ", "or", " ", "anti"}], "-", "parallel"}], 
               "*)"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{"T1", "-", "T2"}], "]"}], "<", "1*^-5"}], "||", 
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{"T1", "+", "T2"}], "]"}], "<", "1*^-5"}]}], ",", 
                RowBox[{
                 RowBox[{"prevCheck1", "=", "Null"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"prevCheck2", "=", "Null"}], ";", 
                 "\[IndentingNewLine]", 
