        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "kappa", "]"}], "<", "1*^-10"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"R", "=", 
         RowBox[{"1.0", "/", "kappa"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "R", "]"}], ">", "RMax"}], ",", 
          RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p", "+", 
         RowBox[{"N", "*", "R"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "focal", " ", "set"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFocalSetImplicit", "[", 
      RowBox[{"points_", ",", 
       RowBox[{"RMax_", ":", " ", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"focalPoints", "=", 
          RowBox[{"{", "}"}]}], ",", "fp"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fp", "=", 
            RowBox[{"computeFocalPointImplicit", "[", 
             RowBox[{"p", ",", "RMax"}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"fp", "=!=", "Null"}], "&&", 
              RowBox[{"VectorQ", "[", 
               RowBox[{"fp", ",", "NumericQ"}], "]"}]}], ",", 
