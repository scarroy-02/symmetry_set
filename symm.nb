              RowBox[{"focalPoints", ",", "fp"}], "]"}]}], "]"}], ";"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"p", ",", "points"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "focalPoints"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "symmetry", " ", "set"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"computeSymmetrySetImplicit", "[", 
      RowBox[{"points_", ",", 
       RowBox[{"lambdaMax_", ":", " ", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"centers", "=", 
          RowBox[{"{", "}"}]}], ",", "nPoints", ",", "thresholdIdx", ",", "i",
          ",", "j", ",", "p1", ",", "p2", ",", "T1", ",", "N1", ",", "T2", 
